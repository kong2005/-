/* ===== 页面基础 ===== */
.lesson-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #F8F3E8 0%, #EDE4CC 60%, #E8D5A3 100%);
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ===== 顶部导航 ===== */
.cu-navbar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #1A1A2E 0%, #2C2C4A 60%, #3A1F1A 100%);
  border-bottom: 2rpx solid rgba(201, 168, 76, 0.5);
  position: sticky;
  top: 0;
  z-index: 100;
  flex-shrink: 0;
  box-shadow: 0 4rpx 32rpx rgba(13, 27, 42, 0.45);
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(201, 168, 76, 0.12);
  border: 1rpx solid rgba(201, 168, 76, 0.3);
  flex-shrink: 0;
  transition: background 0.2s;
}

.nav-back:active {
  background: rgba(201, 168, 76, 0.28);
}

.nav-back-icon {
  color: #C9A84C;
  font-size: 32rpx;
  font-weight: bold;
}

.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  opacity: 0;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  color: #C9A84C;
  font-weight: bold;
  letter-spacing: 4rpx;
  font-family: "STKaiti", "KaiTi", serif;
  text-shadow: 0 0 16rpx rgba(201, 168, 76, 0.4);
}

/* ===== 滚动区 ===== */
.content-scroll {
  flex: 1;
  height: calc(100vh - 120rpx);
  width: 100%;
}

/* ===== 章节容器 ===== */
.section-container {
  padding: 28rpx 24rpx 40rpx;
}

/* ===== 章节入场动画 ===== */
@keyframes sectionFadeUp {
  0% {
    opacity: 0;
    transform: translateY(40rpx) scale(0.97);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.section-anim {
  animation: sectionFadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  margin-bottom: 48rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 32rpx rgba(13, 27, 42, 0.12);
  border: 1rpx solid rgba(201, 168, 76, 0.2);
}

/* ===== 章节头部 ===== */
.section-header {
  margin-bottom: 24rpx;
  position: relative;
  display: flex;
  flex-direction: column;
}

.section-title {
  font-size: 36rpx;
  color: #1A1A2E;
  font-weight: bold;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  font-family: "STKaiti", "KaiTi", serif;
}

.section-subtitle {
  font-size: 24rpx;
  color: #C9A84C;
  letter-spacing: 1rpx;
  font-style: italic;
}

.recite-btn {
  position: absolute;
  right: 0;
  top: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(201, 168, 76, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(201, 168, 76, 0.3);
  transition: all 0.3s ease;
}

.recite-btn.reciting {
  background: rgba(201, 168, 76, 0.2);
  border-color: #C9A84C;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

.recite-icon {
  width: 32rpx;
  height: 32rpx;
}

.recite-text {
  font-size: 24rpx;
  color: #C9A84C;
}

/* 诗句内容优化：鎏金高亮与节奏符号 */
.poem-line {
  display: flex;
  justify-content: center; /* 居中对齐 */
  gap: 8rpx;              /* 字间距稍微拉开一点，更好看 */
  padding: 12rpx 0;       /* 增加行高，方便点击和观察 */
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); /* 平滑过渡 */
  border-radius: 12rpx;   /* 预留一个背景圆角 */
}
/* 2. 默认状态下的文字 */
.poem-char {
  font-size: 36rpx;       /* 稍微加大字号 */
  color: #666;            /* 默认颜色调淡，突出高亮时的对比 */
  transition: all 0.4s;
}

/* 3. 【核心】整行激活时的样式 */
.active-line {
  background: rgba(201, 168, 76, 0.08); /* 给高亮行一个极浅的鎏金背景色 */
  transform: scale(1.02);               /* 轻轻放大整行 */
}

/* 4. 激活行内的文字样式 */
.active-line .poem-char {
  color: #C9A84C;          /* 变为你的主题鎏金色 */
  font-weight: bold;       /* 加粗 */
  text-shadow: 0 0 12rpx rgba(201, 168, 76, 0.3); /* 增加淡淡的辉光感 */
}

/* 5. 隐藏掉不再需要的节奏符号容器（可选） */
.rhythm-symbols {
  display: none !important; 
}

.rhythm-symbols.show {
  opacity: 1;
}

.rhythm-char {
  font-size: 20rpx;
  color: #C9A84C;
  width: 32rpx;
  text-align: center;
}

.poem-line {
  display: flex;
  gap: 4rpx;
}

.poem-char {
  font-size: 34rpx;
  color: #333;
  transition: all 0.3s;
}

.char-highlight {
  color: #C9A84C;
  text-shadow: 0 0 10rpx rgba(201, 168, 76, 0.8), 0 0 20rpx rgba(201, 168, 76, 0.4);
  transform: scale(1.1);
  font-weight: bold;
}

.active-line .poem-char {
  color: #444;
}

/* ===== 封面章节 ===== */
.section-cover {
  text-align: center;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, rgba(26, 26, 46, 0.08) 0%, rgba(255, 255, 255, 0.95) 100%);
}

.section-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 32rpx;
  text-align: center;
}

.section-meta {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 24rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #888;
  text-align: center;
}

/* ===== 介绍章节 ===== */
.characters-section {
  margin: 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.character-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: rgba(201, 168, 76, 0.06);
  border-radius: 16rpx;
  border: 1rpx solid rgba(201, 168, 76, 0.2);
}

.character-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 1.5rpx solid rgba(201, 168, 76, 0.12);
  box-shadow: 0 6rpx 16rpx rgba(13,27,42,0.10);
}

.character-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.character-name {
  font-size: 28rpx;
  color: #1A1A2E;
  font-weight: bold;
}

.character-alias {
  font-size: 22rpx;
  color: #C9A84C;
  font-style: italic;
}

.character-desc {
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
}

.goals-section {
  margin-top: 32rpx;
}

.goals-title {
  font-size: 28rpx;
  color: #1A1A2E;
  font-weight: bold;
  margin-bottom: 20rpx;
  text-align: center;
}

.goal-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
}

.goal-icon {
  font-size: 24rpx;
  color: #C9A84C;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.goal-text {
  flex: 1;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* ===== 原文呈现章节 ===== */
.section-poem {
  background: linear-gradient(135deg, rgba(248, 243, 232, 0.95) 0%, rgba(255, 255, 255, 0.95) 100%);
}

.poem-content {
  font-size: 26rpx;
  color: #1A1A2E;
  line-height: 1.8;
  text-align: center;
  font-family: "STKaiti", "KaiTi", serif;
  white-space: pre-wrap;
}

/* ===== 诗乐解构章节 ===== */
.stanza-item {
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: rgba(26, 26, 46, 0.04);
  border-radius: 16rpx;
  border: 1rpx solid rgba(26, 26, 46, 0.1);
}

.stanza-verse {
  font-size: 26rpx;
  color: #1A1A2E;
  font-weight: bold;
  margin-bottom: 12rpx;
  font-family: "STKaiti", "KaiTi", serif;
}

.stanza-annotation {
  font-size: 20rpx;
  color: #888;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.stanza-interpretation {
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.stanza-methods {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.method-tag {
  font-size: 20rpx;
  color: #C9A84C;
  background: rgba(201, 168, 76, 0.12);
  padding: 6rpx 16rpx;
  border-radius: 9999rpx;
  border: 1rpx solid rgba(201, 168, 76, 0.3);
}

.methods-summary {
  margin-top: 32rpx;
  padding: 24rpx;
  background: rgba(201, 168, 76, 0.06);
  border-radius: 16rpx;
  border: 1rpx solid rgba(201, 168, 76, 0.2);
}

.summary-title {
  font-size: 28rpx;
  color: #1A1A2E;
  font-weight: bold;
  margin-bottom: 20rpx;
  text-align: center;
}

.summary-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.summary-icon {
  font-size: 24rpx;
  color: #C9A84C;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.summary-text {
  flex: 1;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 乐器科普 */
.section-instrument {
  background: #fff;
  padding: 40rpx;
  border-radius: 24rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.instrument-intro {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 40rpx;
  display: block;
}

.instruments-grid {
  display: grid;
  grid-template-columns: repeat(1, 1fr);
  gap: 32rpx;
}

.instrument-card {
  position: relative;
  background: #fdfaf5;
  border: 1rpx solid #e8e0d0;
  border-radius: 20rpx;
  padding: 32rpx;
  transition: all 0.3s ease;
  overflow: hidden;
}

/* 移动端点击反馈 */
.instrument-active {
  background: #f8f3e8;
  border-color: #C9A84C;
  transform: scale(0.98);
  box-shadow: inset 0 0 20rpx rgba(201, 168, 76, 0.1);
}

/* PC 端鼠标滑过高亮 */
.instrument-card:hover {
  background: #fdfaf5;
  border-color: #C9A84C;
  box-shadow: 0 12rpx 32rpx rgba(201, 168, 76, 0.15);
  transform: translateY(-4rpx);
}

.instrument-card:hover .instrument-name {
  color: #C9A84C;
}

.instrument-card:hover .click-hint {
  background: #C9A84C;
  color: #fff;
  opacity: 1;
}

.instrument-playing {
  transform: scale(1.03);
  border-color: #C9A84C;
  box-shadow: 0 0 28rpx rgba(201, 168, 76, 0.6);
  background: rgba(201, 168, 76, 0.1);
}

.instrument-icon {
  width: 120rpx;
  height: 120rpx;
  float: left;
  margin-right: 24rpx;
  border-radius: 12rpx;
  background: #fff;
}

.instrument-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.instrument-dynasty {
  font-size: 22rpx;
  color: #C9A84C;
  background: rgba(201, 168, 76, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-bottom: 12rpx;
  display: inline-block;
}

.instrument-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: block;
  clear: both;
  margin-top: 16rpx;
}

.click-hint {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 20rpx;
  color: #C9A84C;
  border: 1rpx solid #C9A84C;
  padding: 4rpx 12rpx;
  border-radius: 99rpx;
  opacity: 0.8;
}

/* ===== 历代对比入口 ===== */
.comparison-banner {
  margin-top: 40rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #1A1A2E 0%, #2A2A4E 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 20rpx rgba(26, 26, 46, 0.2);
}

.banner-left {
  flex: 1;
}

.banner-title {
  font-size: 30rpx;
  color: #C9A84C;
  font-weight: bold;
  margin-bottom: 8rpx;
  display: block;
}

.banner-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  display: block;
}

.banner-arrow {
  font-size: 28rpx;
  color: #C9A84C;
  margin-left: 20rpx;
}

/* ===== 弹窗通用样式 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 85%;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  animation: modalIn 0.3s ease;
}

@keyframes modalIn {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.modal-header {
  padding: 32rpx;
  background: #f8f8f8;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  color: #1A1A2E;
  font-weight: bold;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  padding: 40rpx;
}

/* 详情项 */
.detail-item {
  margin-bottom: 30rpx;
}

.detail-label {
  font-size: 24rpx;
  color: #C9A84C;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.detail-text {
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
}

/* 对比分析弹窗特有样式 */
.comparison-modal {
  max-height: 80vh;
  overflow-y: auto;
}

.comparison-card {
  padding: 24rpx;
  background: #fdfaf2;
  border-radius: 16rpx;
  border-left: 8rpx solid #C9A84C;
  margin-bottom: 24rpx;
}

.comp-title {
  font-size: 28rpx;
  color: #1A1A2E;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.comp-row {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.comp-label {
  color: #888;
  font-weight: bold;
}

.comp-text {
  color: #444;
}

/* 对比弹窗 Tab */
.comp-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.comp-tab {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  font-size: 24rpx;
  color: #666;
  border: 1rpx solid #eee;
}

.comp-tab.active {
  background: #C9A84C;
  color: #fff;
  border-color: #C9A84C;
}

/* 对比卡片：匹配高亮 */ 
.highlight-card { 
  opacity: 1; 
  transform: scale(1.02); 
  border: 2rpx solid #c9a96e; 
  background: #fffbf2; 
  transition: all 0.3s ease; 
} 
 
/* 对比卡片：不匹配变灰 */ 
.dim-card { 
  opacity: 0.35; 
  transform: scale(0.97); 
  filter: grayscale(60%); 
  transition: all 0.3s ease; 
} 
 
/* 匹配项的艺术手法文字高亮 */ 
.highlight-text { 
  color: #c9a96e; 
  font-weight: bold; 
}

/* ===== 艺术成就章节 ===== */
.achievement-item {
  margin-bottom: 28rpx;
  padding: 24rpx;
  background: rgba(26, 26, 46, 0.04);
  border-radius: 16rpx;
  border: 1rpx solid rgba(26, 26, 46, 0.1);
}

.achievement-title {
  font-size: 26rpx;
  color: #1A1A2E;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.achievement-desc {
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
}

.quotes-section {
  margin-top: 32rpx;
  padding: 24rpx;
  background: rgba(201, 168, 76, 0.06);
  border-radius: 16rpx;
  border: 1rpx solid rgba(201, 168, 76, 0.2);
}

.quotes-title {
  font-size: 28rpx;
  color: #1A1A2E;
  font-weight: bold;
  margin-bottom: 20rpx;
  text-align: center;
}

.quote-item {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 12rpx;
  border: 1rpx solid rgba(201, 168, 76, 0.1);
}

.quote-text {
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 12rpx;
  font-style: italic;
}

.quote-author {
  font-size: 20rpx;
  color: #888;
  text-align: right;
}

/* ===== 文学史价值章节 ===== */
.value-item {
  margin-bottom: 28rpx;
  padding: 24rpx;
  background: rgba(26, 26, 46, 0.04);
  border-radius: 16rpx;
  border: 1rpx solid rgba(26, 26, 46, 0.1);
}

.value-title {
  font-size: 26rpx;
  color: #1A1A2E;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.value-desc {
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
}

.heritage-section {
  margin-top: 32rpx;
  padding: 24rpx;
  background: rgba(201, 168, 76, 0.06);
  border-radius: 16rpx;
  border: 1rpx solid rgba(201, 168, 76, 0.2);
}

.heritage-title {
  font-size: 28rpx;
  color: #1A1A2E;
  font-weight: bold;
  margin-bottom: 20rpx;
  text-align: center;
}

.heritage-item {
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

/* ===== 课堂总结章节 ===== */
.summaries-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.summary-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  border: 1rpx solid rgba(201, 168, 76, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(13, 27, 42, 0.08);
  text-align: center;
}

.summary-card-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.summary-card-title {
  font-size: 28rpx;
  color: #1A1A2E;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.summary-card-desc {
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
}

.tasks-section {
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: rgba(26, 26, 46, 0.04);
  border-radius: 16rpx;
  border: 1rpx solid rgba(26, 26, 46, 0.1);
}

.tasks-title {
  font-size: 28rpx;
  color: #1A1A2E;
  font-weight: bold;
  margin-bottom: 20rpx;
  text-align: center;
}

.task-item {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 12rpx;
  border: 1rpx solid rgba(201, 168, 76, 0.1);
}

.task-title {
  font-size: 24rpx;
  color: #1A1A2E;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.task-desc {
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
}

.closing-section {
  padding: 32rpx;
  background: linear-gradient(135deg, rgba(201, 168, 76, 0.12) 0%, rgba(255, 255, 255, 0.8) 100%);
  border-radius: 16rpx;
  border: 1rpx solid rgba(201, 168, 76, 0.3);
  text-align: center;
}

.closing-text {
  font-size: 26rpx;
  color: #1A1A2E;
  line-height: 1.8;
  font-family: "STKaiti", "KaiTi", serif;
  white-space: pre-wrap;
  text-shadow: 0 0 8rpx rgba(201, 168, 76, 0.2);
}
/* ===== 对比分析：筛选高亮/变灰 ===== */
.comparison-card {
  transition: opacity 0.3s ease, transform 0.3s ease;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border: 2rpx solid transparent;
}

.highlight-card {
  opacity: 1;
  transform: scale(1.02);
  border-color: #c9a96e;
  background: #fffbf2;
  box-shadow: 0 4rpx 20rpx rgba(201, 169, 110, 0.2);
}

.dim-card {
  opacity: 0.3;
  transform: scale(0.97);
}

.highlight-text {
  color: #c9a96e;
  font-weight: bold;
}

/* ===== 对比Tab激活样式（如果缺失） ===== */
.comp-tab {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #888;
  background: #f5f5f5;
  transition: all 0.2s ease;
}

.comp-tab.active {
  color: #fff;
  background: #c9a96e;
  font-weight: bold;
}

.scene-entry-btn {
  margin-top: 20rpx;
  margin-left: auto;
  margin-right: auto;
  min-width: 280rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  background: linear-gradient(90deg, #C9A84C 0%, #E8D5A3 100%);
  color: #1A1A2E;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(201, 168, 76, 0.3);
  border: none;
}

.scene-entry-btn::after {
  border: none;
}