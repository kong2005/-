<view class="ai-dialog-wrap">
  <!-- 触发入口按钮 -->
  <view wx:if="{{showEntry}}" class="ai-entry" bindtap="openDialog">
    <view class="entry-avatar-wrap">
      <image class="entry-avatar" src="https://hpi-hub.tos-cn-beijing.volces.com/static/batch_14/1757368300999-7522.png" mode="aspectFit" />
      <view class="entry-glow" />
    </view>
    <view class="entry-label">
      <text class="entry-name">李贺</text>
      <text class="entry-hint">点击开启双时空对话</text>
    </view>
    <view class="entry-seal">
      <text class="seal-text">李贺</text>
    </view>
  </view>

  <!-- 对话弹窗 -->
  <view wx:if="{{visible}}" class="dialog-mask">
    <view class="dialog-panel">
      <!-- 顶部头部 -->
      <view class="dialog-header">
        <view class="header-left">
          <view class="avatar-wrap">
            <image class="avatar-img" src="https://hpi-hub.tos-cn-beijing.volces.com/static/batch_14/1757368300999-7522.png" mode="aspectFit" />
            <view wx:if="{{isLoading}}" class="avatar-pulse" />
          </view>
          <view class="header-info">
            <text class="dialog-title">李贺</text>
            <view class="status-row">
            <view class="status-dot {{isLoading ? 'loading' : 'active'}}" />
            <text class="status-text">{{isLoading ? '思索中…' : '在线'}}</text>
          </view>
        </view>
      </view>
      <view class="header-close" bindtap="closeDialog">
        <text class="close-icon">✕</text>
      </view>
    </view>

    <!-- 消息区域 -->
    <scroll-view
      class="messages-scroll"
      scroll-y
      scroll-top="{{scrollTop}}"
      scroll-with-animation="true"
    >
      <view class="messages-inner">
        <!-- 欢迎语 -->
        <view wx:if="{{messages.length === 0}}" class="welcome-wrap">
          <view class="welcome-card">
            <text class="welcome-quote">
              "余闻李凭弹箜篌，音绕梁宇，动星摇石，遂作此篇，记其神妙。"
            </text>
            <text class="welcome-sub">—— 李贺</text>
            <view class="welcome-divider" />
            <text class="welcome-tips">可向我提问关于诗歌、箜篌、大唐音乐的一切</text>
            <view class="quick-questions">
              <view
                wx:for="{{quickQuestions}}"
                wx:key="index"
                class="quick-btn"
                bindtap="sendQuick"
                data-question="{{item}}"
              >
                <text class="quick-text">{{item}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 消息列表 -->
        <block wx:for="{{messages}}" wx:key="index">
          <!-- AI消息 -->
          <view wx:if="{{item.role === 'ai'}}" class="msg-row row-ai">
            <image
              class="msg-avatar"
              src="https://hpi-hub.tos-cn-beijing.volces.com/static/batch_14/1757368300999-7522.png"
              mode="aspectFit"
            />
            <view class="bubble bubble-ai">
              <text class="bubble-text">{{item.content}}</text>
              <text class="bubble-time">{{item.time}}</text>
            </view>
          </view>

          <!-- 用户消息 -->
          <view wx:if="{{item.role === 'user'}}" class="msg-row row-user">
            <image
                  class="msg-avatar"
                  src="https://img.icons8.com/fluency/96/user-male-circle.png"
                  mode="aspectFit"
                />
            <view class="bubble bubble-user">
              <text class="bubble-text">{{item.content}}</text>
              <text class="bubble-time">{{item.time}}</text>
            </view>
          </view>
        </block>

          <!-- loading气泡 -->
          <view wx:if="{{isLoading}}" class="msg-row row-ai">
            <image
              class="msg-avatar"
              src="https://hpi-hub.tos-cn-beijing.volces.com/static/batch_14/1757368300999-7522.png"
              mode="aspectFit"
            />
            <view class="bubble bubble-ai bubble-loading">
              <view class="loading-dots">
                <view class="ldot" />
                <view class="ldot" style="animation-delay:0.2s;" />
                <view class="ldot" style="animation-delay:0.4s;" />
              </view>
            </view>
          </view>

          <!-- 底部占位 -->
          <view style="height:20rpx;" />
        </view>
      </scroll-view>

      <!-- 错误提示 -->
      <view wx:if="{{errorMsg}}" class="error-bar">
        <text class="error-text">⚠ {{errorMsg}}</text>
        <text class="error-close" bindtap="clearError">✕</text>
      </view>

      <!-- 输入区域 -->
      <view class="input-area">
        <view class="input-row">
          <!-- 语音按钮 -->
          <view
            class="voice-btn {{isRecording ? 'voice-active' : ''}}"
            bindtap="toggleVoice"
          >
            <text class="voice-icon">{{isRecording ? '🔴' : '🎙'}}</text>
          </view>

          <!-- 文字输入 -->
          <view class="input-wrap">
            <input
              class="text-input"
              value="{{inputText}}"
              placeholder="{{inputPlaceholder}}"
              placeholder-style="color:rgba(201,168,76,0.5);font-size:26rpx;"
              maxlength="200"
              disabled="{{isLoading}}"
              bindconfirm="sendMessage"
              bindinput="onInput"
            />
          </view>

          <!-- 发送按钮 -->
          <view
            class="send-btn {{inputText.trim().length > 0 && !isLoading ? 'send-active' : ''}}"
            bindtap="sendMessage"
          >
            <text class="send-icon">↑</text>
          </view>
        </view>

        <!-- 语音状态提示 -->
        <view wx:if="{{isRecording}}" class="recording-tip">
          <view class="rec-wave">
            <view wx:for="{{[1,2,3,4,5]}}" wx:key="index" class="wave-bar" style="animation-delay: {{(index-1)*0.12}}s" />
          </view>
          <text class="rec-text">正在聆听，松开发送…</text>
        </view>
      </view>
    </view>
  </view>
</view>